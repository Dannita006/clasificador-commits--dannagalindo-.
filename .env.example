# Plantilla de variables de entorno.
# Copiela como .env (cp .env.example .env) y CAMBIE las contrasenas
# si va a desplegar fuera de su computador. Si cambia DB_PASSWORD o
# DB_ADMIN_PASSWORD, cambie tambien la contrasena de app_ia en db/init.sql.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iadb
DB_USER=app_ia
DB_PASSWORD=claveApp456
DB_ADMIN_PASSWORD=claveAdmin123

OLLAMA_URL=http://localhost:11434/api/generate
# Cambielo por el modelo de su perfil (A: qwen2.5-coder:1.5b, B: qwen2.5:0.5b, C: gemma3:270m)
MODELO_OLLAMA=gemma3:270m
MOTOR_POR_DEFECTO=eco
